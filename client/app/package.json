{
  "name": "@grimworld/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client shell: React, PixiJS rendered on demand, starknet.js for the chain (ADR-0003, ADR-0007).",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:node": "vitest run src/account/burner.node.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:hubs": "node verify-hubs.mjs",
    "verify:ground": "node verify-ground.mjs",
    "verify:chrome": "node verify-chrome.mjs",
    "verify:keys": "node verify-keys.mjs"
  },
  "dependencies": {
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "starknet": "10.8.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
