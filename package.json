{
  "name": "grimworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Grim World: client workspace (the contracts are in contracts/).",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "devEngines": { "packageManager": { "name": "pnpm", "version": ">=1" } },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write client"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
